{
  "name": "thesisflow-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "node scripts/check-config.mjs && wrangler deploy",
    "check": "wrangler deploy --dry-run --outdir .build",
    "db:local": "wrangler d1 execute thesisflow --local --file=schema.sql",
    "db:remote": "node scripts/check-config.mjs && wrangler d1 execute thesisflow --remote --file=schema.sql",
    "seed:local": "node scripts/seed.mjs --local",
    "seed:remote": "node scripts/check-config.mjs && node scripts/seed.mjs --remote",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "miniflare": "5.20260930.0-alpha",
    "wrangler": "4.145.0"
  }
}
